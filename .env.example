# ── LLM (required) ──────────────────────────────────────────────────────────
LLM_PROVIDER=mock            # mock | http | bob
LLM_BASE_URL=http://localhost:11434/v1   # override for local/IBM Bob endpoint
LLM_API_KEY=                 # leave blank if the endpoint needs no key
LLM_MODEL=gpt-4o-mini        # model name forwarded to the provider

# ── Source retrieval ─────────────────────────────────────────────────────────
# Used as polite "mailto" param for Crossref / OpenAlex / Unpaywall
CONTACT_EMAIL=you@example.com

# Semantic Scholar (optional – raises rate limit when provided)
S2_API_KEY=

# ── Feature flags ────────────────────────────────────────────────────────────
# Set to "true" to bypass real LLM/retrieval calls and use canned responses
USE_MOCKS=true

# ── Database / Paths ─────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/citeverify.db
DATA_DIR=./data
UPLOADS_DIR=./data/uploads
UPLOAD_DIR=data/uploads
SOURCES_DIR=data/sources
CACHE_DIR=data/cache

# ── Embedding model ──────────────────────────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── M2 – Source Retrieval ────────────────────────────────────────────────────
# Chunking (words)
CHUNK_WORDS=250
CHUNK_OVERLAP_WORDS=50

# Passage retrieval
TOP_K=5
LOW_RETRIEVAL_THRESHOLD=0.35

# Title matching thresholds (rapidfuzz token_set_ratio, 0-100 scale)
TITLE_RATIO_MATCHED=85
TITLE_RATIO_SOLO=92
YEAR_TOLERANCE=1

# Quote location fuzzy threshold (rapidfuzz partial_ratio, 0-100)
QUOTE_FUZZY_THRESHOLD=90

# HTTP client
HTTP_TIMEOUT=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.5

# OCR DPI for image-only PDF pages
OCR_DPI=200
