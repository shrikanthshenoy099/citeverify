# ── Contact (used as mailto param for Crossref / OpenAlex / Unpaywall) ──────────
CONTACT_EMAIL=your.email@example.com

# ── LLM Provider ────────────────────────────────────────────────────────────────
# mock | http | bob   (default: mock)
LLM_PROVIDER=mock

# ── GenericHTTPLLMClient (used when LLM_PROVIDER=http) ──────────────────────────
LLM_BASE_URL=https://your-llm-host/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=gpt-4o-mini

# ── BobLLMClient (used when LLM_PROVIDER=bob) ───────────────────────────────────
# Details TBD — fill in when IBM Bob API details are confirmed.
BOB_ENDPOINT=
BOB_API_KEY=

# ── Semantic Scholar (optional, raises rate-limit ceiling) ───────────────────────
S2_API_KEY=

# ── App ─────────────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///./data/citeverify.db
UPLOAD_DIR=data/uploads
SOURCES_DIR=data/sources
CACHE_DIR=data/cache

# ── M2 – Source Retrieval ────────────────────────────────────────────────────
# Sentence-transformers model for chunk embeddings.
# Change only if you want a different model (requires full re-index of all sources).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Chunking (words)
CHUNK_WORDS=250
CHUNK_OVERLAP_WORDS=50

# Passage retrieval
TOP_K=5
LOW_RETRIEVAL_THRESHOLD=0.35

# Title matching thresholds (rapidfuzz token_set_ratio, 0-100 scale)
TITLE_RATIO_MATCHED=85
TITLE_RATIO_SOLO=92
YEAR_TOLERANCE=1

# Quote location fuzzy threshold (rapidfuzz partial_ratio, 0-100)
QUOTE_FUZZY_THRESHOLD=90

# HTTP client
HTTP_TIMEOUT=20
HTTP_MAX_RETRIES=3
HTTP_BACKOFF_FACTOR=1.5

# OCR DPI for image-only PDF pages
OCR_DPI=200

